# Copy to .env.local and fill in. Never commit real secrets.

# PostgreSQL connection (local dev: see README)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/indepbank_dev

# Separate database used by integration tests (isolation tests, stage 3+)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/indepbank_test

# Public base URL of the app
APP_URL=http://localhost:3000

# Auth (stage 3): generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
